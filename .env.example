APP_ENV=development
HTTP_ADDRESS=:8080
LOG_LEVEL=debug
# 本地开发：宿主机端口 5433（5432 被本机原生 PostgreSQL 占用，见 compose.dev.yml）
DATABASE_URL=postgres://personal_site:personal_site_dev@localhost:5433/personal_site?sslmode=disable
PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# 必须与 docs/api/openapi.yaml 的 securitySchemes.RefreshCookie.name 一致
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
JWT_PRIVATE_KEY_FILE=../secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_FILE=../secrets/jwt_public_key.pem
VISITOR_SECRET_FILE=../secrets/visitor_secret.txt
CONTENT_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=